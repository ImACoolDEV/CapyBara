-- GitHub Target Fetcher
local function getTargetGunName()
    local cfgSuccess, response = pcall(function()
        return game:HttpGet(GITHUB_CONFIG_URL)
    end)
    
    if cfgSuccess and response then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeSuccess and decoded and decoded.GunName then
            return decoded.GunName
        end
    end
    return customWeaponNameInput
end

-- Core ModuleScript Modifier
local function modifyGunModule(tool)
    local settingScript = tool:FindFirstChild("Setting")
    if settingScript and settingScript:IsA("ModuleScript") then
        local success, config = pcall(require, settingScript)
        if success and type(config) == "table" then
            -- 1. Infinite Ammo
            config.LimitedClipEnabled = false 
            config.AmmoPerClip = math.huge
            config.MaxClip = math.huge
            
            -- 2. No Spread
            config.Spread = 0
            config.SpreadRedution = 0
            
            -- 3. No Recoil
            config.CameraShakingEnabled = false
            
            -- 4. Fast Fire Rate & Auto
            config.FireRate = 0
            config.Auto = true
            config.BurstFireEnabled = false
            config.DelayBeforeFiring = 0
            config.DelayAfterFiring = 0
            
            print("Successfully injected ModuleScript settings into:", tool.Name)
            return true
        end
    end
    return false
end

