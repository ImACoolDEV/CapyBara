-- Fetch external raw script safely from GitHub
local success, rawScript = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/ImACoolDEV/CapyBara/main/Capybara%20Hub")
end)

if success and rawScript then
    local func, err = loadstring(rawScript)
    if func then
        task.spawn(func)
    else
        warn("Lua syntax error in GitHub script:", err)
    end
else
    warn("Failed to fetch script from GitHub URL.")
end

