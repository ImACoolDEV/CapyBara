    corner.Parent = frame

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0.9, 0, 0.8, 0)
    textBox.Position = UDim2.new(0.05, 0, 0.1, 0)
    textBox.BackgroundTransparency = 1
    textBox.Text = tostring(defaultText)
