-- One-time Apply Settings Mod
ApplyModBtn.MouseButton1Click:Connect(function()
    local targetName = getTargetGunName()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    
    local tool = (backpack and backpack:FindFirstChild(targetName)) 
        or (character and character:FindFirstChild(targetName))

    if tool then
        local modified = modifyGunModule(tool)
        if modified then
            ApplyModBtn.Text = "✅ Modified " .. targetName .. "!"
            task.delay(2, function() ApplyModBtn.Text = "⚡ Apply Settings Module Mod" end)
        else
            warn("Could not find 'Setting' ModuleScript in " .. targetName)
        end
    else
        warn("Gun '" .. targetName .. "' not found in Backpack or Character.")
    end
end)

-- Auto Loop Modifier (Checks setting script continually)
GunModBtn.MouseButton1Click:Connect(function()
    AUTO_GUN_MOD_ENABLED = not AUTO_GUN_MOD_ENABLED
    GunModBtn.Text = AUTO_GUN_MOD_ENABLED and "🔫 Auto Gun Loop: ON" or "🔫 Auto Gun Loop: OFF"
    GunModBtn.BackgroundColor3 = AUTO_GUN_MOD_ENABLED and Color3.fromRGB(180, 95, 30) or Color3.fromRGB(45, 30, 22)
    GunModStroke.Color = AUTO_GUN_MOD_ENABLED and Color3.fromRGB(255, 185, 90) or Color3.fromRGB(110, 75, 55)

    if AUTO_GUN_MOD_ENABLED then
        gunModLoop = RunService.Heartbeat:Connect(function()
            local targetName = getTargetGunName()
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local character = LocalPlayer.Character
            
            local containers = {backpack, character}
            for _, container in ipairs(containers) do
                if container then
                    local tool = container:FindFirstChild(targetName)
                    if tool and tool:IsA("Tool") and not modifiedWeapons[tool] then
                        local success = modifyGunModule(tool)
                        if success then modifiedWeapons[tool] = true end
                    end
                end
            end
        end)
    else
        if gunModLoop then gunModLoop:Disconnect() gunModLoop = nil end
        table.clear(modifiedWeapons)
    end
end)

