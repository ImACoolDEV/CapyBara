-- Function to search game storage and give the requested tool
local function giveTool(toolName)
    if not toolName or toolName == "" then
        warn("No tool name provided.")
        return false
    end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    -- Search places where tools are normally stored
    local searchLocations = {
        ReplicatedStorage,
        Workspace,
        game:GetService("Lighting")
    }

    local foundTool = nil

    for _, location in ipairs(searchLocations) do
        for _, obj in ipairs(location:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower() == toolName:lower() then
                foundTool = obj
                break
            end
        end
        if foundTool then break end
    end

    if foundTool then
        local toolClone = foundTool:Clone()
        if backpack then
            toolClone.Parent = backpack
            print("Successfully gave tool: " .. toolClone.Name .. " to Backpack!")
            return true
        end
    else
        warn("Tool '" .. toolName .. "' was not found in ReplicatedStorage, Workspace, or Lighting.")
        return false
    end
end

