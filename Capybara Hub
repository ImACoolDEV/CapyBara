                for _, tool in ipairs(container:GetChildren()) do
                    if tool:IsA("Tool") then
                        for _, wName in ipairs(WEAPON_PRIORITY) do
                            if string.find(string.lower(tool.Name), string.lower(wName)) or string.find(string.lower(tool.Name), "gun") or string.find(string.lower(tool.Name), "rifle") then
                                if not modifiedWeapons[tool] then
                                    modifiedWeapons[tool] = true
                                    for _, desc in ipairs(tool:GetDescendants()) do
                                        if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                                            local dName = string.lower(desc.Name)
                                            if string.find(dName, "damage") or string.find(dName, "power") then
                                                desc.Value = desc.Value * 5
                                            elseif string.find(dName, "fire") or string.find(dName, "rate") or string.find(dName, "cooldown") then
                                                desc.Value = 0.01
                                            elseif string.find(dName, "spread") or string.find(dName, "recoil") then
                                                desc.Value = 0
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    else
        if gunModLoop then gunModLoop:Disconnect() gunModLoop = nil end
        table.clear(modifiedWeapons)
    end
end)

