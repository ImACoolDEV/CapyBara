UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == TOGGLE_KEY then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

GiveToolBtn.MouseButton1Click:Connect(function()
    local nameToGive = ToolTextBox.Text ~= "" and ToolTextBox.Text or targetToolName
    local successGive = giveTool(nameToGive)
    
    if successGive then
        GiveToolBtn.Text = "✅ Given: " .. nameToGive
    else
        GiveToolBtn.Text = "❌ Tool Not Found!"
    end
    
    task.delay(2, function()
        GiveToolBtn.Text = "🎁 Give Tool"
    end)
end)

SpeedBtn.MouseButton1Click:Connect(function()
    SPEED_BOOST_ENABLED = not SPEED_BOOST_ENABLED
    SpeedBtn.Text = SPEED_BOOST_ENABLED and "⚡ Speed Boost: ON" or "⚡ Speed Boost: OFF"
    SpeedBtn.BackgroundColor3 = SPEED_BOOST_ENABLED and Color3.fromRGB(180, 95, 30) or Color3.fromRGB(45, 30, 22)
    SpeedStroke.Color = SPEED_BOOST_ENABLED and Color3.fromRGB(255, 185, 90) or Color3.fromRGB(110, 75, 55)
    
    local character = LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then
        character:FindFirstChildOfClass("Humanoid").WalkSpeed = SPEED_BOOST_ENABLED and 32 or 16
    end
end)

local defaultFogEnd, defaultBrightness = Lighting.FogEnd, Lighting.Brightness

FogBtn.MouseButton1Click:Connect(function()
    noFogActive = not noFogActive
    FogBtn.Text = noFogActive and "💡 No Fog / Fullbright: ON" or "💡 No Fog / Fullbright: OFF"
    FogBtn.BackgroundColor3 = noFogActive and Color3.fromRGB(180, 95, 30) or Color3.fromRGB(45, 30, 22)
    FogStroke.Color = noFogActive and Color3.fromRGB(255, 185, 90) or Color3.fromRGB(110, 75, 55)
    
    Lighting.FogEnd = noFogActive and 9e9 or defaultFogEnd
    Lighting.Brightness = noFogActive and 2 or defaultBrightness
end)
