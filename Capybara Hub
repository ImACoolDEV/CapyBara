local function giveToolToInventory(toolName)
    if not toolName or toolName == "" then return false end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local starterGear = LocalPlayer:FindFirstChild("StarterGear")
    local searchLocations = { ReplicatedStorage, Workspace, Lighting, game:GetService("ServerStorage") }
    local foundTool = nil

    for _, location in ipairs(searchLocations) do
        for _, obj in ipairs(location:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower() == toolName:lower() then
                foundTool = obj
                break
            end
        end
        if foundTool then break end
    end

    if foundTool then
        if backpack then foundTool:Clone().Parent = backpack end
        if starterGear then foundTool:Clone().Parent = starterGear end
        return true
    end
    return false
end

local function modifyStat(statName, amount)
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local stat = leaderstats:FindFirstChild(statName)
        if stat then
            stat.Value = stat.Value + amount
            return true
        end
    end
    return false
end

local function safeTouchInterest(part1, part2)
    if typeof(firetouchinterest) == "function" then
        pcall(function() firetouchinterest(part1, part2, 0) firetouchinterest(part1, part2, 1) end)
    else
        pcall(function() if not part2.Anchored then part2.CFrame = part1.CFrame end end)
    end
end

local function executeSpamClick()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    elseif VirtualUser then
        pcall(function()
            VirtualUser:Button1Down(Vector2.zero, Workspace.CurrentCamera.CFrame)
            VirtualUser:Button1Up(Vector2.zero, Workspace.CurrentCamera.CFrame)
        end)
    end
end

local function findTargetModel(query)
    local qLower = query:lower()
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:lower():find(qLower) then
            local p = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChildWhichIsA("BasePart")
            if p then return obj, p end
        end
    end
    return nil, nil
end

