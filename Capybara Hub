--------------------------------------------------------------------------------
-- TOOL GIVER LOGIC
--------------------------------------------------------------------------------
local function giveToolToInventory(toolName)
    if not toolName or toolName == "" then return false end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local starterGear = LocalPlayer:FindFirstChild("StarterGear")

    -- Search game directories for the tool
    local searchLocations = {
        ReplicatedStorage,
        Workspace,
        Lighting,
        game:GetService("ServerStorage") -- May fail client-side if restricted, but safe to check
    }

    local foundTool = nil

    for _, location in ipairs(searchLocations) do
        for _, obj in ipairs(location:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name:lower() == toolName:lower() then
                foundTool = obj
                break
            end
        end
        if foundTool then break end
    end

    if foundTool then
        -- Clone and insert into Backpack
        if backpack then
            local clonedTool = foundTool:Clone()
            clonedTool.Parent = backpack
        end
        -- Also place in StarterGear so it persists on respawn if supported
        if starterGear then
            local clonedTool2 = foundTool:Clone()
            clonedTool2.Parent = starterGear
        end
        return true
    end

    return false
end

--------------------------------------------------------------------------------
-- LEADERSTATS LOGIC
--------------------------------------------------------------------------------
local function addPoints(amount)
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local points = leaderstats:FindFirstChild("Points")
        if points then
            points.Value = points.Value + amount
            return true
        end
    end
    return false
end

